<?xml version="1.0" encoding="utf-8"?>
<!-- Navy from the status bar down: no title bar (the top bar shows who you are talking to) -->
<resources>
    <style name="Henchline" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:colorAccent">@color/cyan</item>
        <!-- Every touch ripple: 12% white on the dark surfaces (Motion.RIPPLE) -->
        <item name="android:colorControlHighlight">#1FFFFFFF</item>
    </style>
    <!-- The send-later time: a clock face to tap the hour and minute on, in the app's colours -->
    <style name="Clock" parent="@android:style/Theme.Material.Dialog">
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:timePickerStyle">@style/ClockFace</item>
    </style>
    <style name="ClockFace" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">clock</item>
    </style>
</resources>
